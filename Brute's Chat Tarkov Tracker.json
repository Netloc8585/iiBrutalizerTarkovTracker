function doGet(e) {
  var props = PropertiesService.getScriptProperties();
  var action = e.parameter.action;
  var stat = e.parameter.stat;

  function get(key) {
    return parseInt(props.getProperty(key) || '0');
  }

  if (action === 'add') {
    var val = get(stat) + 1;
    props.setProperty(stat, val.toString());
    return ContentService.createTextOutput(stat + ' added! Now: ' + val);
  }

  if (action === 'remove') {
    var val = Math.max(0, get(stat) - 1);
    props.setProperty(stat, val.toString());
    return ContentService.createTextOutput(stat + ' removed. Now: ' + val);
  }

  if (action === 'stats') {
    var raids = get('raids');
    var extracts = get('extracts');
    var deaths = get('deaths');
    var kills = get('kills');
    var sr = raids > 0 ? Math.round((extracts / raids) * 100) : 0;
    var kdr = deaths > 0 ? (kills / deaths).toFixed(2) : kills.toFixed(2);
    return ContentService.createTextOutput(
      'Raids: ' + raids + ' | Extracts: ' + extracts + ' | Deaths: ' + deaths +
      ' | SR: ' + sr + '% | PMC Kills: ' + kills + ' | K/DR: ' + kdr
    );
  }

  if (action === 'reset') {
    props.deleteProperty('raids');
    props.deleteProperty('extracts');
    props.deleteProperty('deaths');
    props.deleteProperty('kills');
    return ContentService.createTextOutput('Stats reset!');
  }

  return ContentService.createTextOutput('Unknown action');
}
